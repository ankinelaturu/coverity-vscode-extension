{
  "name": "coverity-report-helper",
  "displayName": "Coverity Report Helper",
  "description": "Load cov-format-errors multiline reports; Explorer badges, Problems, editor navigation.",
  "version": "0.1.24",
  "icon": "media/duck.svg",
  "publisher": "anki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coverity",
          "title": "Coverity",
          "icon": "media/duck.svg"
        }
      ],
      "panel": [
        {
          "id": "coverityDetails",
          "title": "Coverity Details",
          "icon": "media/duck.svg"
        }
      ]
    },
    "views": {
      "coverity": [
        {
          "type": "webview",
          "id": "coverity.fullTrace",
          "name": "Full Trace",
          "when": "coverity.hasReport"
        }
      ],
      "coverityDetails": [
        {
          "type": "webview",
          "id": "coverity.issueDetails",
          "name": "Issue Details",
          "when": "coverity.hasReport"
        }
      ]
    },
    "commands": [
      {
        "command": "coverity.loadReport",
        "title": "Load Report",
        "icon": "$(folder-opened)",
        "category": "Coverity"
      },
      {
        "command": "coverity.reloadReport",
        "title": "Reload Report",
        "icon": "$(refresh)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showProblems",
        "title": "Show Coverity in Problems",
        "icon": "$(warning)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showParseOutput",
        "title": "Show Parse Output",
        "icon": "$(output)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.rerunCoverity",
        "title": "Rerun Analysis",
        "icon": "$(run-all)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.configurePathMapping",
        "title": "Configure Path Mapping",
        "icon": "$(link-external)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.resetAdjustedLocations",
        "title": "Reset Adjusted Locations",
        "icon": "$(discard)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.navigateToStep",
        "title": "Navigate to Coverity Event",
        "category": "Coverity"
      },
      {
        "command": "coverity.setActiveFindingStep",
        "title": "Set Active Coverity Event",
        "category": "Coverity"
      },
      {
        "command": "coverity.traceStepRelative",
        "title": "Coverity Event (Relative)",
        "category": "Coverity"
      },
      {
        "command": "coverity.pickTraceStep",
        "title": "Pick Coverity Event",
        "category": "Coverity"
      },
      {
        "command": "coverity.chooseFindingsAtLine",
        "title": "Choose Coverity Issue at Line",
        "category": "Coverity"
      },
      {
        "command": "coverity.cycleFindingAtLine",
        "title": "Cycle Coverity Issue at Line",
        "category": "Coverity"
      },
      {
        "command": "coverity.pickFindingAtLine",
        "title": "Pick Coverity Issue at Line",
        "category": "Coverity"
      },
      {
        "command": "coverity.previousTraceStep",
        "title": "Previous Coverity Event",
        "icon": "$(arrow-up)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.nextTraceStep",
        "title": "Next Coverity Event",
        "icon": "$(arrow-down)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.cycleHoverFinding",
        "title": "Cycle Coverity Issue at Caret Line (legacy)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showTracePeek",
        "title": "Full Trace",
        "icon": "$(list-flat)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showIssueDetails",
        "title": "Issue Details",
        "icon": "$(book)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.applyPossibleFix",
        "title": "Apply Possible Fix",
        "icon": "$(lightbulb)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.pickProblemsTypeFilter",
        "title": "Filter Coverity by Checker",
        "icon": {
          "light": "media/duck.svg",
          "dark": "media/duck.svg"
        },
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "coverity.pickProblemsTypeFilter",
          "when": "view == workbench.panel.markers.view && coverity.hasReport",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "coverity.showTracePeek",
          "when": "coverity.hasReport && (editorLangId == c || editorLangId == cpp)",
          "group": "navigation@50"
        },
        {
          "command": "coverity.showIssueDetails",
          "when": "coverity.hasReport && (editorLangId == c || editorLangId == cpp)",
          "group": "navigation@51"
        }
      ],
      "commandPalette": [
        { "command": "coverity.loadReport" },
        { "command": "coverity.reloadReport", "when": "coverity.hasReport" },
        { "command": "coverity.showProblems", "when": "coverity.hasReport" },
        { "command": "coverity.showParseOutput", "when": "coverity.hasReport" },
        { "command": "coverity.configurePathMapping", "when": "coverity.hasReport" },
        { "command": "coverity.resetAdjustedLocations", "when": "coverity.hasReport" },
        { "command": "coverity.rerunCoverity", "when": "coverity.hasReport" },
        { "command": "coverity.previousTraceStep", "when": "coverity.hasReport" },
        { "command": "coverity.nextTraceStep", "when": "coverity.hasReport" },
        { "command": "coverity.showTracePeek", "when": "coverity.hasReport" },
        { "command": "coverity.showIssueDetails", "when": "coverity.hasReport" },
        { "command": "coverity.applyPossibleFix", "when": "coverity.hasReport" },
        { "command": "coverity.pickProblemsTypeFilter", "when": "coverity.hasReport" }
      ]
    },
    "configuration": {
      "title": "Coverity Report",
      "properties": {
        "coverity.autoLoadReport": {
          "type": "boolean",
          "default": true,
          "description": "When a workspace opens, load the default report path if the file exists."
        },
        "coverity.defaultReportPath": {
          "type": "string",
          "default": "deploy/coverity/coverity-report.txt",
          "description": "Report path relative to each workspace folder root (not relative to the report file location)."
        },
        "coverity.pathMappings": {
          "type": "array",
          "default": [],
          "description": "Map report path prefixes to workspace paths. Each item: { \"reportPrefix\": \"C:\\\\build\\\\interstellar\", \"workspaceFolder\": \"interstellar\" }.",
          "items": {
            "type": "object",
            "properties": {
              "reportPrefix": { "type": "string" },
              "workspaceFolder": { "type": "string" }
            }
          }
        },
        "coverity.hoverRichTimeline": {
          "type": "boolean",
          "default": true,
          "description": "Use SVG timeline table in hover; when false, use a plain Markdown event list."
        },
        "coverity.fullTraceFollowActive": {
          "type": "boolean",
          "default": true,
          "description": "After Full Trace is opened, refresh the sidebar when you change the active issue or event (CodeLens, hover, prev/next)."
        },
        "coverity.issueDetailsFollowActive": {
          "type": "boolean",
          "default": true,
          "description": "Refresh Issue Details when the editor caret moves onto a Coverity finding line, or when the active finding changes (Problems, CodeLens, hover)."
        },
        "coverity.codeLensEnabled": {
          "type": "boolean",
          "default": true
        },
        "coverity.traceStepMarkEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Wavy underline on path events except the last event line (Problems diagnostic); that line uses Problems only. Underline color follows editorInfo; text color unchanged."
        },
        "coverity.traceStepBackgroundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Deprecated — use coverity.traceStepMarkEnabled. When traceStepMarkEnabled is unset, this toggles the event underline."
        },
        "coverity.traceBadgesEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show the COV trace strip between line numbers and code (experimental; off by default). When enabling, set editor.lineDecorationsWidth (e.g. 72px) if the column is too narrow."
        },
        "coverity.explorerDecorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Coverity issue badges and colors on files/folders in Explorer."
        },
        "coverity.explorerBadgeStyle": {
          "type": "string",
          "default": "duck",
          "enum": ["count", "brand", "duck"],
          "enumDescriptions": [
            "Show issue count (e.g. 3 or 99+)",
            "Legacy alias for duck (🦆1–🦆9 / 🦆+)",
            "Show 🦆1–🦆9 for that many unique issues, 🦆+ for 10 or more (full count in tooltip)"
          ],
          "description": "Badge text in Explorer. Duck style uses 🦆 plus digit 1–9, or 🦆+ when count ≥ 10."
        },
        "coverity.explorerHighlightActiveFile": {
          "type": "boolean",
          "default": true,
          "description": "Use a distinct color on the Explorer entry for the active editor file when it has issues."
        },
        "coverity.experimentalTraceLanes": {
          "type": "boolean",
          "default": true,
          "description": "Reserve a fixed-width COV strip between line numbers and code for the whole file; draw multi-lane trace graph and event nodes only on the active issue's path."
        },
        "coverity.traceGutterLaneCount": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 12,
          "description": "Number of horizontal lane columns in the trace gutter (fixed total width = lane count × lane width)."
        },
        "coverity.traceGutterLaneWidth": {
          "type": "number",
          "default": 8,
          "minimum": 6,
          "maximum": 16,
          "description": "Pixel width of each lane column in the trace gutter (default 8×8 = 64px)."
        },
        "coverity.traceStripCodeLensBandPx": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 48,
          "description": "Reserved. Per-line strip extension for CodeLens gaps is disabled (causes extra filled rectangles in Cursor). CodeLens layout is unchanged."
        },
        "coverity.traceStripConnectors": {
          "type": "boolean",
          "default": false,
          "description": "When trace badges are on: draw box-drawing connectors between in-file events in the COV strip. Uses text, not SVG."
        },
        "coverity.rerun.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Rerun command (requires trusted workspace and manual runner configuration)."
        },
        "coverity.rerun.commandLine": {
          "type": "string",
          "default": "",
          "description": "Placeholder: shell command or script to run analysis (user-supplied; not executed from report contents)."
        },
        "coverity.rerun.reportOutputPath": {
          "type": "string",
          "default": "",
          "description": "Path to the report file produced by rerun, relative to workspace root or absolute."
        },
        "coverity.rerun.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to save all dirty editors before starting a rerun."
        }
      }
    },
    "keybindings": [
      {
        "command": "coverity.previousTraceStep",
        "key": "alt+shift+up",
        "when": "coverity.hasReport"
      },
      {
        "command": "coverity.nextTraceStep",
        "key": "alt+shift+down",
        "when": "coverity.hasReport"
      }
    ]
  }
}
