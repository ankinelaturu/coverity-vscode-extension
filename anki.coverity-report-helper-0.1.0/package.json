{
  "name": "coverity-report-helper",
  "displayName": "Coverity Report Helper",
  "description": "Load cov-format-errors multiline reports; Explorer badges, Problems, editor navigation.",
  "version": "0.1.2",
  "icon": "media/duck.svg",
  "publisher": "anki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coverity.loadReport",
        "title": "Load Report",
        "icon": "$(folder-opened)",
        "category": "Coverity"
      },
      {
        "command": "coverity.reloadReport",
        "title": "Reload Report",
        "icon": "$(refresh)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showProblems",
        "title": "Show Coverity in Problems",
        "icon": "$(warning)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.showParseOutput",
        "title": "Show Parse Output",
        "icon": "$(output)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.rerunCoverity",
        "title": "Rerun Analysis",
        "icon": "$(run-all)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.configurePathMapping",
        "title": "Configure Path Mapping",
        "icon": "$(link-external)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.resetAdjustedLocations",
        "title": "Reset Adjusted Locations",
        "icon": "$(discard)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.navigateToStep",
        "title": "Navigate to Trace Step",
        "category": "Coverity"
      },
      {
        "command": "coverity.previousTraceStep",
        "title": "Previous Trace Step",
        "icon": "$(arrow-up)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.nextTraceStep",
        "title": "Next Trace Step",
        "icon": "$(arrow-down)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      },
      {
        "command": "coverity.compareRuns",
        "title": "Compare Runs",
        "icon": "$(diff)",
        "category": "Coverity",
        "enablement": "coverity.hasReport"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "coverity.loadReport" },
        { "command": "coverity.reloadReport", "when": "coverity.hasReport" },
        { "command": "coverity.showProblems", "when": "coverity.hasReport" },
        { "command": "coverity.showParseOutput", "when": "coverity.hasReport" },
        { "command": "coverity.configurePathMapping", "when": "coverity.hasReport" },
        { "command": "coverity.resetAdjustedLocations", "when": "coverity.hasReport" },
        { "command": "coverity.rerunCoverity", "when": "coverity.hasReport" },
        { "command": "coverity.compareRuns", "when": "coverity.hasReport" },
        { "command": "coverity.previousTraceStep", "when": "coverity.hasReport" },
        { "command": "coverity.nextTraceStep", "when": "coverity.hasReport" }
      ]
    },
    "configuration": {
      "title": "Coverity Report",
      "properties": {
        "coverity.autoLoadReport": {
          "type": "boolean",
          "default": true,
          "description": "When a workspace opens, load the default report path if the file exists."
        },
        "coverity.defaultReportPath": {
          "type": "string",
          "default": "deploy/coverity/coverity-report.txt",
          "description": "Report path relative to each workspace folder root (not relative to the report file location)."
        },
        "coverity.pathMappings": {
          "type": "array",
          "default": [],
          "description": "Map report path prefixes to workspace paths. Each item: { \"reportPrefix\": \"C:\\\\build\\\\interstellar\", \"workspaceFolder\": \"interstellar\" }.",
          "items": {
            "type": "object",
            "properties": {
              "reportPrefix": { "type": "string" },
              "workspaceFolder": { "type": "string" }
            }
          }
        },
        "coverity.codeLensEnabled": {
          "type": "boolean",
          "default": true
        },
        "coverity.traceBadgesEnabled": {
          "type": "boolean",
          "default": true
        },
        "coverity.explorerDecorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Coverity finding badges and colors on files/folders in Explorer."
        },
        "coverity.explorerBadgeStyle": {
          "type": "string",
          "default": "duck",
          "enum": ["count", "brand", "duck"],
          "enumDescriptions": [
            "Show finding count (e.g. 3 or 99+)",
            "Legacy alias for duck (🦆1–🦆9 / 🦆+)",
            "Show 🦆1–🦆9 for that many unique findings, 🦆+ for 10 or more (full count in tooltip)"
          ],
          "description": "Badge text in Explorer. Duck style uses 🦆 plus digit 1–9, or 🦆+ when count ≥ 10."
        },
        "coverity.explorerHighlightActiveFile": {
          "type": "boolean",
          "default": true,
          "description": "Use a distinct color on the Explorer entry for the active editor file when it has findings."
        },
        "coverity.experimentalTraceLanes": {
          "type": "boolean",
          "default": false,
          "description": "Experimental gutter lanes are not implemented; setting reserved for future use."
        },
        "coverity.rerun.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Rerun command (requires trusted workspace and manual runner configuration)."
        },
        "coverity.rerun.commandLine": {
          "type": "string",
          "default": "",
          "description": "Placeholder: shell command or script to run analysis (user-supplied; not executed from report contents)."
        },
        "coverity.rerun.reportOutputPath": {
          "type": "string",
          "default": "",
          "description": "Path to the report file produced by rerun, relative to workspace root or absolute."
        },
        "coverity.compareRunsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Optional compare-runs feature (basic snapshot support)."
        }
      }
    },
    "keybindings": [
      {
        "command": "coverity.previousTraceStep",
        "key": "alt+shift+up",
        "when": "coverity.hasReport"
      },
      {
        "command": "coverity.nextTraceStep",
        "key": "alt+shift+down",
        "when": "coverity.hasReport"
      }
    ]
  }
}
